# SalonSniper Configuration

# Helius API Configuration
HELIUS_RPC=https://mainnet.helius-rpc.com/?api-key=7c8922d6-1031-42c1-b4ee-bf5daa29abd4
HELIUS_SECURE_RPC=https://vivianne-2tu8xb-fast-mainnet.helius-rpc.com
HELIUS_WS=wss://mainnet.helius-rpc.com/?api-key=7c8922d6-1031-42c1-b4ee-bf5daa29abd4
HELIUS_PARSE_TX=https://api.helius.xyz/v0/transactions/?api-key=7c8922d6-1031-42c1-b4ee-bf5daa29abd4
HELIUS_TX_HISTORY=https://api.helius.xyz/v0/addresses/{address}/transactions/?api-key=7c8922d6-1031-42c1-b4ee-bf5daa29abd4

# Listener Configuration
BATCH_WINDOW_MS=300
DEDUP_TTL_S=30
REST_FALLBACK_LIMIT_PER_SEC=20
MAX_BACKLOG_EVENTS=10000
WS_RECONNECT_MAX_DELAY_S=60

# Pipeline Configuration
GLOBAL_FILTER_DEADLINE_MS=900
SCORE_THRESHOLD=50
WORKER_POOL_SIZE=8

# Filter Thresholds
# LocalRouteGate PI thresholds
PI_THRESHOLD_HIGH_LIQ=3    # >= 300 SOL
PI_THRESHOLD_MED_LIQ=6     # 100-300 SOL  
PI_THRESHOLD_LOW_LIQ=10    # < 100 SOL
MIN_LIQUIDITY_SOL=40
DX_TEST_SOL=0.02

# LP Protection
MIN_BURN_PERCENTAGE=80

# Pool Size
MIN_POOL_SIZE_NEW=40       # age < 10 min
MIN_POOL_SIZE_MED=120      # age 10-60 min
MIN_POOL_SIZE_OLD=200      # age > 60 min

# Holder Distribution
MAX_TOP1_PERCENTAGE=40
MAX_TOP5_PERCENTAGE=70

# Trade Executor Configuration
MAX_CONCURRENT_TRADES=3
EXECUTION_TIMEOUT_MS=15000
MAX_RETRIES=2
POSITION_SIZE_SOL=0.1
MAX_POSITION_SOL=1.0
BANKROLL_FRACTION=0.05

# Exit Strategy
TAKE_PROFIT_PERCENTAGE=30
STOP_LOSS_PERCENTAGE=20
MAX_HOLD_TIME_MINUTES=6

# Wallet Configuration
WALLET_MODE=internal  # internal | phantom
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE  # Only for internal mode

# Logging Configuration
LOG_LEVEL=info
SESSION_LOG_RETENTION_DAYS=7
CHECKPOINT_INTERVAL_S=5

# External APIs
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex
DEXSCREENER_CACHE_TTL_S=60

# Alerts Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
WEBHOOK_URL=YOUR_WEBHOOK_URL

# Development
NODE_ENV=development
DEBUG=salonsniper:*

# Filter Pipeline Configuration
FILTER_PIPELINE_ENABLED=true
FILTER_SCORE_THRESHOLD=0

# Individual Filter Configuration
DEDUP_FILTER_ENABLED=false
DEDUP_CRITICAL=false

SANITY_FILTER_ENABLED=false
SANITY_CRITICAL=false

RENOUNCED_FILTER_ENABLED=true
RENOUNCED_CRITICAL=true
RENOUNCED_REQUIRE_MINT_RENOUNCED=true
RENOUNCED_REQUIRE_FREEZE_RENOUNCED=true

MUTABLE_FILTER_ENABLED=true
MUTABLE_CRITICAL=true
MUTABLE_PENALTY_MUTABLE=-0.3
MUTABLE_BONUS_IMMUTABLE=0.2
MUTABLE_BONUS_SOCIAL_LINKS=0.1
MUTABLE_TIMEOUT_MS=1000

ROUTE_GATE_FILTER_ENABLED=true
ROUTE_GATE_CRITICAL=false
ROUTE_GATE_TIMEOUT_MS=3000
ROUTE_GATE_TEST_AMOUNT_SOL=0.02
ROUTE_GATE_CACHE_TTL_MS=60000
ROUTE_GATE_PI_THRESHOLD_HIGH_LIQ=0.03
ROUTE_GATE_PI_THRESHOLD_MED_LIQ=0.06
ROUTE_GATE_PI_THRESHOLD_LOW_LIQ=0.1
ROUTE_GATE_HIGH_LIQ_THRESHOLD=300
ROUTE_GATE_MED_LIQ_THRESHOLD=100

# Jupiter API Configuration (Updated to v1)
JUPITER_QUOTE_AMOUNT_SOL=0.02
JUPITER_MAX_PRICE_IMPACT_BPS=600
JUPITER_REQUEST_TIMEOUT_MS=8000
JUPITER_RETRIES=3
JUPITER_REQUEST_CONCURRENCY=5
JUPITER_REQUEST_DELAY_MS=100
JUPITER_CACHE_TTL_S=60
JUPITER_BACKOFF_BASE_MS=200
JUPITER_RESTRICT_INTERMEDIATE=true
JUPITER_ONLY_DIRECT_ROUTES=false

LP_PROTECTION_ENABLED=true
LP_PROTECTION_CRITICAL=true
LP_PROTECTION_MODE=STRICT
LP_TOP1_MAX=50
LP_TOP5_MAX=80
LP_PI_DELTA_MAX_BPS=500

POOL_SIZE_ENABLED=true
POOL_SIZE_CRITICAL=true
MIN_EL_SOL=1.5
JUP_TARGET_PI_BPS=500
EL_SMALL_SOL=0.05
EL_BIG_SOL=2.0
EL_MAX_STEPS=4
V_CHECK_ENABLED=false
ROUTE_GATE_MODE=LOG_ONLY

# 3.7 Pool Size High Liquidity Settings
EL_SLOPE_MAX_BPS=250
JUP_QPS_MAX=55
JUP_CONCURRENCY=2
JUP_CACHE_TTL_MS=60000
JUP_TIMEOUT_MS=3000
HOLDERS_ENABLED=true
HOLDERS_MODE=LOG_ONLY

# --- Jupiter API (Lite/Pro Plan) ---
# Jupiter plan: lite | pro
JUPITER_PLAN=lite

# Quote endpoints (не хардкодь в коде, только через env)
JUPITER_QUOTE_URL_LITE=https://lite-api.jup.ag/swap/v1/quote
JUPITER_QUOTE_URL_PRO=https://api.jup.ag/swap/v1/quote

# Pro API key (не обязателен для lite)
JUPITER_API_KEY=

# Флаг моков ДОЛЖЕН быть false
JUPITER_USE_MOCK=false

# --- RPC fallback ---
RPC_URL=https://rpc.hel.io
RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# --- Alternative Jupiter endpoints ---

# --- Mock Jupiter API (для тестирования) ---
JUPITER_MOCK_PRICE_IMPACT_MIN=50
JUPITER_MOCK_PRICE_IMPACT_MAX=600
JUPITER_MOCK_EL_SOL_MIN=0.1
JUPITER_MOCK_EL_SOL_MAX=2.0
PROCESSING_DELAY_MS=100
